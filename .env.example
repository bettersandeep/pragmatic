# pragmatic settings. Copy to .env and fill in what you need; empty lines keep the default.
# Defaults run pragmatic for one person on this machine: no sign-in, data in ./data.

# --- Address ---------------------------------------------------------------------------------
# The address people open pragmatic at. Default http://localhost:3100. Sign-in redirects and links use it.
# Local development with `npm run dev`: http://localhost:5173. A team: http://<this host>:3100 or your https name.
BASE_URL=
# Listen address and port. Default 127.0.0.1:3100 (this machine only); 0.0.0.0 for a network (the container sets it).
HOST=
PORT=
# docker compose only: the address the port is published on. 0.0.0.0 to reach it from the network.
PRAGMATIC_BIND=
# Behind a reverse proxy (https): how many proxies to trust for the client address, for example 1.
# Without it, the sign-in limits count every person as the proxy's address.
TRUST_PROXY=

# --- Sign-in ------------------------------------------------------------------------------------
# local = no sign-in, one person, this machine only (the default).
# For a team, one or more of: oidc, password, google (comma separated), for example AUTH=oidc,password
AUTH=local
# Who may sign in and be shared with, by email domain (comma separated). Empty: anyone the sign-in mode lets in.
ALLOWED_EMAIL_DOMAINS=
# AUTH=local: the name and email shown for you (defaults: your OS user name, me@localhost).
LOCAL_USER_NAME=
LOCAL_USER_EMAIL=

# AUTH=oidc: any OpenID Connect provider (Keycloak, Authentik, Okta, Microsoft Entra, JumpCloud, Google Workspace).
# Register pragmatic with redirect URI <BASE_URL>/auth/oidc/callback and the scopes openid email profile.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The name on the sign-in button ("Continue with ..."), and the scopes if your provider needs others.
OIDC_NAME=
OIDC_SCOPES=

# AUTH=password: accounts in pragmatic. The first person to open a new install creates the admin account;
# admins invite people with links (pragmatic sends no email). Nothing to set here.

# --- Google (AUTH=google sign-in, and Google Drive copies in any mode) ------------------------------
# A Google OAuth client of type "Web application", redirect URI <BASE_URL>/auth/google/callback,
# with the Google Drive API on. With it, Settings shows "Connect Google Drive" (a backup of your boards).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Data -----------------------------------------------------------------------------------------
# Folder for the built-in database, uploaded images and the key file. Default ./data (the container: /data).
PRAGMATIC_DATA=
# A Postgres server instead of the built-in database, for example postgres://user:password@host:5432/pragmatic
# (add ?sslmode=verify-full for a server with TLS; a private CA, such as Amazon RDS's, also needs NODE_EXTRA_CA_CERTS).
DATABASE_URL=
# Key that encrypts Google tokens (base64 of 32 random bytes: openssl rand -base64 32). Empty: a key file in the data folder.
PRAGMATIC_SECRET=

# --- Board pictures --------------------------------------------------------------------------------
# Chrome or Chromium for board pictures (Drive copies, Claude's export_board). Empty: the usual install path.
CHROME_PATH=
# The URL the picture renderer opens (the container sets it). Default: BASE_URL.
RENDER_URL=

# --- Development only ----------------------------------------------------------------------------------
# /auth/dev signs in as this email from 127.0.0.1. Leave empty anywhere else.
PRAGMATIC_DEV_LOGIN=
