{
  "name": "pragmatic",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/main.ts & vite",
    "build": "vite build && npm run build:mcpb",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "test": "node --test server/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:mcpb": "npm ci --prefix claude-desktop --omit=dev --no-audit --no-fund && mcpb pack claude-desktop dist/pragmatic.mcpb"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@blocknote/server-util": "^0.55.0",
    "@electric-sql/pglite": "^0.5.11",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "lib0": "^0.2.119",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@blocknote/mantine": "^0.55.0",
    "@excalidraw/mermaid-to-excalidraw": "^2.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "y-websocket": "^3.1.0"
  },
  "overrides": {
    "nanoid@4": "5.1.16",
    "katex": "0.19.0",
    "lodash-es": "4.18.1"
  }
}
