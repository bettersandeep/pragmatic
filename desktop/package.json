{
  "name": "pragmatic-desktop",
  "productName": "pragmatic",
  "version": "0.2.0",
  "private": true,
  "description": "pragmatic desktop app with a Claude Code panel",
  "main": "main.js",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper",
    "start": "electron .",
    "dist": "node stage-server.mjs && electron-builder --mac dmg --arm64 --x64"
  },
  "build": {
    "appId": "app.pragmatic.desktop",
    "productName": "pragmatic",
    "files": [
      "main.js",
      "preload.js",
      "panel.html",
      "panel.js",
      "settings.html",
      "settings.js",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": "dmg"
    },
    "npmRebuild": false,
    "afterPack": "./after-pack.cjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  }
}
